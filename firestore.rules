rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isAllowedEmail() {
      return signedIn()
        && authEmail() != ''
        && exists(/databases/$(database)/documents/allowed_emails/$(authEmail()));
    }

    function roleDoc() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid))
        && role in roleDoc().data.roles;
    }

    function isMember() {
      return hasRole('admin') || hasRole('manager') || hasRole('developer');
    }

    function isStaff() {
      return hasRole('admin') || hasRole('manager');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function bootstrapDone() {
      return exists(/databases/$(database)/documents/meta/bootstrap);
    }

    // Allowlist: document ID = lowercase email.
    match /allowed_emails/{emailId} {
      allow get: if isAdmin() || (signedIn() && authEmail() == emailId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /meta/bootstrap {
      allow read: if signedIn() && isAllowedEmail();
      allow create: if isAllowedEmail() && !bootstrapDone()
        && request.resource.data.bootstrapped == true
        && request.resource.data.first_admin_uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /profiles/{userId} {
      allow read: if isMember() || (signedIn() && request.auth.uid == userId && isAllowedEmail());
      allow create: if signedIn() && request.auth.uid == userId && isAllowedEmail();
      allow update: if signedIn() && request.auth.uid == userId && isAllowedEmail();
      allow delete: if isAdmin();
    }

    match /user_roles/{userId} {
      allow read: if isMember() || (signedIn() && request.auth.uid == userId && isAllowedEmail());
      allow create: if signedIn()
        && request.auth.uid == userId
        && isAllowedEmail()
        && (
          (request.resource.data.roles.size() == 1
            && request.resource.data.roles[0] == 'developer'
            && bootstrapDone())
          ||
          (request.resource.data.roles.size() == 1
            && request.resource.data.roles[0] == 'admin'
            && !bootstrapDone())
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /clients/{id} {
      allow read: if isMember();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /client_contacts/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /projects/{id} {
      allow read: if isMember();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /milestones/{id} {
      allow read: if isMember();
      allow create, update: if isMember();
      allow delete: if isStaff();
    }

    match /project_resources/{id} {
      allow read, create, update: if isMember();
      allow delete: if isStaff();
    }

    match /sprints/{id} {
      allow read, create, update: if isMember();
      allow delete: if isStaff();
    }

    match /tasks/{id} {
      allow read, create, update: if isMember();
      allow delete: if isStaff();
    }

    match /transactions/{id} {
      allow read: if isStaff()
        || (
          isMember()
          && resource.data.tx_type == 'payroll'
          && resource.data.payee_id == request.auth.uid
        );
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /payroll_profiles/{userId} {
      allow read: if isStaff()
        || (signedIn() && request.auth.uid == userId && isMember());
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /settings/kpis {
      allow read: if isMember();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Public website CMS (site_*) ──

    match /site_settings/{key} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /site_categories/{id} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /site_projects/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /site_testimonials/{id} {
      allow read: if resource.data.is_visible == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /site_leads/{id} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'service_type', 'project_details', 'status', 'created_at'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.service_type is string
        && request.resource.data.service_type.size() <= 120
        && request.resource.data.project_details is string
        && request.resource.data.project_details.size() <= 4000
        && request.resource.data.status == 'new'
        && request.resource.data.created_at is string;
      allow read, update, delete: if isStaff();
    }

    match /site_audit_leads/{id} {
      function auditCreateValid() {
        return request.resource.data.keys().hasAll([
            'name', 'whatsapp', 'business_type', 'monthly_volume', 'team_size',
            'challenges', 'status', 'source', 'created_at', 'updated_at', 'notes',
            'step_reached', 'step_label', 'completed', 'visitor_key', 'is_repeat'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() <= 40
          && request.resource.data.business_type is string
          && request.resource.data.business_type.size() > 0
          && request.resource.data.business_type.size() <= 120
          && request.resource.data.monthly_volume is string
          && request.resource.data.monthly_volume.size() <= 80
          && request.resource.data.team_size is string
          && request.resource.data.team_size.size() <= 80
          && request.resource.data.challenges is list
          && request.resource.data.challenges.size() <= 2
          && request.resource.data.status == 'in_progress'
          && request.resource.data.source == 'audit_landing'
          && request.resource.data.created_at is string
          && request.resource.data.updated_at is string
          && request.resource.data.notes is string
          && request.resource.data.notes.size() == 0
          && request.resource.data.step_reached is int
          && request.resource.data.step_reached >= 1
          && request.resource.data.step_reached <= 5
          && request.resource.data.step_label is string
          && request.resource.data.step_label.size() <= 80
          && request.resource.data.completed == false
          && request.resource.data.visitor_key is string
          && request.resource.data.visitor_key.size() >= 8
          && request.resource.data.visitor_key.size() <= 80
          && request.resource.data.is_repeat is bool;
      }

      function auditPublicUpdateValid() {
        return resource.data.source == 'audit_landing'
          && resource.data.completed == false
          && request.resource.data.source == 'audit_landing'
          && request.resource.data.created_at == resource.data.created_at
          && request.resource.data.visitor_key == resource.data.visitor_key
          && request.resource.data.is_repeat == resource.data.is_repeat
          && request.resource.data.keys().hasAll([
              'name', 'whatsapp', 'business_type', 'monthly_volume', 'team_size',
              'challenges', 'status', 'source', 'created_at', 'updated_at', 'notes',
              'step_reached', 'step_label', 'completed', 'visitor_key', 'is_repeat'
            ])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() <= 40
          && request.resource.data.business_type is string
          && request.resource.data.business_type.size() > 0
          && request.resource.data.business_type.size() <= 120
          && request.resource.data.monthly_volume is string
          && request.resource.data.monthly_volume.size() <= 80
          && request.resource.data.team_size is string
          && request.resource.data.team_size.size() <= 80
          && request.resource.data.challenges is list
          && request.resource.data.challenges.size() <= 2
          && request.resource.data.status in ['in_progress', 'new']
          && request.resource.data.updated_at is string
          && request.resource.data.notes == resource.data.notes
          && request.resource.data.step_reached is int
          && request.resource.data.step_reached >= resource.data.step_reached
          && request.resource.data.step_reached <= 6
          && request.resource.data.step_label is string
          && request.resource.data.step_label.size() <= 80
          && request.resource.data.completed is bool
          && (
            (request.resource.data.completed == false
              && request.resource.data.status == 'in_progress')
            ||
            (request.resource.data.completed == true
              && request.resource.data.status == 'new'
              && request.resource.data.name.size() > 0
              && request.resource.data.whatsapp.size() >= 8)
          );
      }

      allow create: if auditCreateValid();
      allow update: if isStaff() || auditPublicUpdateValid();
      allow read, delete: if isStaff();
    }
  }
}
